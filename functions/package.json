{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx -y firebase-tools emulators:start --only functions",
    "shell": "npm run build && npx -y firebase-tools functions:shell",
    "start": "npm run shell",
    "deploy": "npx -y firebase-tools deploy --only functions",
    "logs": "npx -y firebase-tools functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.1",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "postmark": "^5.1.0"
  },
  "devDependencies": {
    "eslint": "^8.9.0",
    "typescript": "^4.9.0"
  },
  "private": true
}